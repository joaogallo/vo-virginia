generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CHILD
  PARENT
  TEACHER
  ADMIN
}

enum MedalLevel {
  BRONZE
  SILVER
  GOLD
}

enum OperationType {
  ADDITION
  SUBTRACTION
  MULTIPLICATION
  DIVISION
}

enum SessionMode {
  PRACTICE
  TIMED_TOTAL
  TIMED_PER_QUESTION
  MARATHON
  REVIEW
}

enum NotificationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum FriendshipStatus {
  ACTIVE
  BLOCKED
}

enum ChallengeStatus {
  PENDING
  ACTIVE
  COMPLETED
  DECLINED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role                 UserRole  @default(CHILD)
  maxRetries           Int       @default(5)
  defaultQuestionLimit Int?
  linkCode             String?   @unique
  friendCode           String?   @unique
  friendshipEnabled    Boolean   @default(false)
  challengeEnabled     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  authSessions AuthSession[]
  gameSessions GameSession[]
  parents          ParentChild[]      @relation("ChildToParent")
  children         ParentChild[]      @relation("ParentToChild")
  groups           ChildGroup[]       @relation("UserGroups")
  groupMemberships ChildGroupMember[] @relation("GroupMemberships")
  medals           UserMedal[]
  notificationsReceived Notification[] @relation("NotificationsReceived")
  notificationsSent     Notification[] @relation("NotificationsSent")
  friendshipsInitiated  Friendship[]      @relation("FriendshipInitiator")
  friendshipsReceived   Friendship[]      @relation("FriendshipReceiver")
  challengesIssued      FriendChallenge[] @relation("ChallengesIssued")
  challengesReceived    FriendChallenge[] @relation("ChallengesReceived")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ParentChild {
  id        String   @id @default(cuid())
  parentId  String
  childId   String
  createdAt DateTime @default(now())

  parent User @relation("ParentToChild", fields: [parentId], references: [id], onDelete: Cascade)
  child  User @relation("ChildToParent", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@map("parent_child")
}

model ChildGroup {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaderboardEnabled Boolean @default(false)

  owner   User               @relation("UserGroups", fields: [userId], references: [id], onDelete: Cascade)
  members ChildGroupMember[]

  @@index([userId])
  @@map("child_groups")
}

model ChildGroupMember {
  id      String @id @default(cuid())
  groupId String
  childId String

  group ChildGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  child User       @relation("GroupMemberships", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([groupId, childId])
  @@map("child_group_members")
}

model GameSession {
  id             String          @id @default(cuid())
  userId         String
  operations     OperationType[]
  numbers        Int[]
  totalQuestions  Int
  correctAnswers Int             @default(0)
  wrongAnswers   Int             @default(0)
  startedAt      DateTime        @default(now())
  endedAt        DateTime?
  completed      Boolean         @default(false)
  mode                        SessionMode @default(PRACTICE)
  timeLimitSeconds            Int?
  timeLimitPerQuestionSeconds Int?
  interruptedAt               DateTime?
  interruptedReason           String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([userId, startedAt])
  @@map("game_sessions")
}

model Answer {
  id            String        @id @default(cuid())
  sessionId     String
  operation     OperationType
  firstOperand  Int
  secondOperand Int
  correctAnswer Int
  userAnswer    Int
  isCorrect     Boolean
  attemptNumber Int
  timeSpentMs   Int
  answeredAt    DateTime      @default(now())

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, answeredAt])
  @@map("answers")
}

model UserMedal {
  id         String      @id @default(cuid())
  userId     String
  medalId    String
  level      MedalLevel?
  unlockedAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, medalId, level])
  @@index([userId])
  @@map("user_medals")
}

model Notification {
  id          String             @id @default(cuid())
  recipientId String
  senderId    String
  type        String
  data        Json
  status      NotificationStatus @default(PENDING)
  readAt      DateTime?
  resolvedBy  String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  recipient User @relation("NotificationsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  sender    User @relation("NotificationsSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([recipientId, status])
  @@index([senderId, type, status])
  @@map("notifications")
}

model Friendship {
  id          String           @id @default(cuid())
  initiatorId String
  receiverId  String
  status      FriendshipStatus @default(ACTIVE)
  blockedBy   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  initiator User @relation("FriendshipInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  receiver  User @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([initiatorId, receiverId])
  @@index([initiatorId, status])
  @@index([receiverId, status])
  @@map("friendships")
}

model FriendChallenge {
  id             String          @id @default(cuid())
  challengerId   String
  challengedId   String
  operations     OperationType[]
  numbers        Int[]
  totalQuestions Int
  questionsSeed  String
  status         ChallengeStatus @default(PENDING)

  challengerCorrect  Int     @default(0)
  challengerWrong    Int     @default(0)
  challengerFinished Boolean @default(false)
  challengerTime     Int?

  challengedCorrect  Int     @default(0)
  challengedWrong    Int     @default(0)
  challengedFinished Boolean @default(false)
  challengedTime     Int?

  challengerInactivity Boolean @default(false)
  challengedInactivity Boolean @default(false)

  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  challenger User @relation("ChallengesIssued", fields: [challengerId], references: [id], onDelete: Cascade)
  challenged User @relation("ChallengesReceived", fields: [challengedId], references: [id], onDelete: Cascade)

  @@index([challengerId, status])
  @@index([challengedId, status])
  @@map("friend_challenges")
}
